# Copy to .env (which is gitignored) and fill in ONE of these.
# API-Football (api-football.com) — needed by src/pull_api_football.py for the
# live season. Free plan only exposes seasons 2021–2023, so the current season
# needs a paid plan ($19+/mo).

# Direct account at dashboard.api-football.com:
API_FOOTBALL_KEY=

# ...OR key obtained through RapidAPI:
# RAPIDAPI_KEY=
