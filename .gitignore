# Python
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/

# Data — raw downloads are reproducible and stay untracked; data/processed/ IS
# committed now (sources + built tables) so the weekly workflow and a fresh
# clone don't depend on the 7-day actions/cache eviction window.
data/raw/
# soccerdata caches (SOCCERDATA_DIR points into these) - just a fetch cache
data/soccerdata/
data/understat_cache/

# Local scratch — diagnostic scripts, sample dumps; never committed
scratch/

# site/data.json is a regenerated build artifact (src/export_site_data.py);
# site/index.html embeds a frozen snapshot of it and is the committed deliverable
site/data.json

# One-off tarball for the old pipeline-seed release (data/processed/ is committed
# now, so the seed mechanism is retired - safe to `gh release delete pipeline-seed`)
pipeline-seed.tar.gz

# Secrets
.env

# OS
Thumbs.db
.DS_Store

# Tooling scratch (seleniumbase / webdriver)
downloaded_files/
latest_logs/
assets/
*.lock

