# Python
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/

# Data - data/raw/ is scratch (raw downloads, reproducible). data/processed/ is
# committed - pulled sources, ledgers, model scores - and is the only record of
# what's been pulled (no fetch cache in CI). The tables the every-2-days refresh
# rebuilds from scratch are listed at the bottom: they ship in the latest-build
# release instead of git history.
data/raw/
# soccerdata caches (SOCCERDATA_DIR points into these) - just a fetch cache
data/soccerdata/
data/understat_cache/
# SQLite mirror of data/processed/*.csv (src/build_sqlite_db.py) - local-only:
# ~150 MB, over GitHub's 100 MB file limit, and nothing in the pipeline reads it
data/processed/xvalue.db

# Local scratch — diagnostic scripts, sample dumps; never committed
scratch/

# site/data.json is a regenerated build artifact (src/export_site_data.py);
# site/index.html embeds it and ships in the latest-build release (bottom)
site/data.json

# One-off tarball for the old pipeline-seed release (data/processed/ is committed
# now, so the seed mechanism is retired - safe to `gh release delete pipeline-seed`)
pipeline-seed.tar.gz

# Secrets
.env

# OS
Thumbs.db
.DS_Store

# Tooling scratch (seleniumbase / webdriver)
downloaded_files/
latest_logs/
assets/
*.lock
# ...except the pinned dependency lockfile, which is committed
!requirements.lock

# Unrelated files that OneDrive syncs into this folder — not part of this project
xValue/
*Setup*.exe
*installer*.exe
chromedriver*.exe
models/

# Claude Code worktrees / local
.claude/

# Rebuilt-every-run outputs - published as the `latest-build` release asset
# (src/sync_build.py fetch / pack), not committed: they grew history ~5 MB a run
data/processed/player_elo.csv
data/processed/match_model_table.csv
data/processed/match_model_upcoming.csv
data/processed/matches_all.csv
data/processed/outcome_model_predictions.csv
data/processed/outcome_model_predictions_hybrid.csv
data/processed/outcome_model_predictions_all.csv
data/processed/value_model_predictions.csv
data/processed/squad_season_features.csv
data/processed/squad_momentum.csv
data/processed/match_lineup_features.csv
data/processed/match_lineup_players.csv
site/index.html
# src/sync_build.py pack output
build/
